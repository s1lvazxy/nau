# Nau reads its whole configuration from the environment, so the same build runs on a laptop,
# in Docker or on a company server. Copy this file to .env and fill in what you need.
# With everything empty, Nau runs in local mode: data stays in the browser and nothing else is needed.

# ── Where this installation is reached (auth redirects, links, webhook addresses shown in the app)
VITE_SITE_URL=http://localhost:3100

# ── Database (Supabase: their cloud, self-hosted, or `supabase start` on your machine)
# Needed for accounts shared between people, connectors, the API, webhooks and the scheduled Operator.
# On localhost, `pnpm setup:local` fills this block from the running local stack.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-side only. Never expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Server secrets
# Seals connector credentials at rest (AES-256-GCM). Generate with: openssl rand -base64 32
# Changing or losing it means reconnecting every system.
NAU_SECRET_KEY=
# The scheduler calls POST /api/cron/tick with "Authorization: Bearer $CRON_SECRET" every five minutes
CRON_SECRET=

# ── Operator (AI). Server-side only. Without a key Nau uses its built-in engine, and standing rules do not run.
ANTHROPIC_API_KEY=
# Optional: another model (default claude-opus-5-5)
NAU_AGENT_MODEL=
# Optional: route model calls through your own gateway or proxy
ANTHROPIC_BASE_URL=
# Optional: "off" keeps the public demo on the built-in engine (no model cost)
NAU_AGENT_DEMO=

# ── Development only: lets connectors and webhooks reach localhost and private addresses
NAU_ALLOW_PRIVATE_HOSTS=
