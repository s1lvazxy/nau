{
  "name": "nau",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Nau \u2014 open-source stock and inventory with an AI operator, built for Portuguese businesses.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:site": "VITE_LANDING_ONLY=1 vite build && node scripts/site-finish.mjs",
